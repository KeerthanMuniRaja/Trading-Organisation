APP_MODE=paper
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=.data/paper
# DATABASE_URL=postgresql://user:password@localhost:5432/trading_organisation
# Generate local credentials with npm run dev:setup; no default credentials exist.
PRINCIPALS_JSON=[]
OWNER_PUBLIC_KEY_BASE64=
# Paper limits only. Changing these requires restarting the owner-controlled service.
MAX_ORDER_PAISE=100000
MAX_EXPOSURE_PAISE=500000
MAX_REALISED_LOSS_PAISE=100000
PAPER_FEE_BPS=10
PAPER_SLIPPAGE_BPS=5
# flat: PAPER_FEE_BPS on each side. nse-delivery: STT, stamp duty, exchange and SEBI fees with GST, and the Rs 15.93
# depository charge on each sale (PAPER_FEE_BPS is then unused). Founder review B28.
PAPER_COST_MODEL=flat
