{
  "name": "trading-organisation",
  "version": "0.1.27",
  "private": true,
  "description": "Owner-controlled trading organisation: paper-first backend and research workers",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "learning:workflow": "node --env-file=.env scripts/learning-workflow-admin.mjs",
    "sources:import": "node --env-file=.env scripts/import-observations.mjs",
    "test:sources": "node --test scripts/import-observations.test.mjs",
    "build": "tsc -p backend/tsconfig.json",
    "test": "npm run build && node --test --test-concurrency=1 backend/dist/test/*.test.js",
    "start": "node --env-file=.env backend/dist/src/main.js",
    "dev:setup": "node scripts/setup-local.mjs",
    "demo": "node --env-file=.env scripts/demo.mjs",
    "worker:research": "node --env-file=.env scripts/run-worker.mjs researcher",
    "worker:evaluation": "node --env-file=.env scripts/run-worker.mjs evaluator",
    "worker:coordination": "node --env-file=.env scripts/run-worker.mjs coordinator",
    "test:ruflo": "node --test integrations/ruflo/coordinator.test.mjs integrations/ruflo/mirror.test.mjs",
    "test:ruflo:live": "npm run build && node integrations/ruflo/live.mjs",
    "ruflo:doctor": "node integrations/ruflo/doctor.mjs",
    "check": "npm run test",
    "academy:run": "node scripts/run-academy.mjs run",
    "academy:test": "node scripts/run-academy.mjs test",
    "worker:portfolio": "node --env-file=.env scripts/run-portfolio.mjs",
    "verify:portfolio": "node scripts/verify-portfolio.mjs",
    "worker:lifecycle": "node --env-file=.env scripts/run-lifecycle.mjs",
    "lifecycle:admin": "node --env-file=.env scripts/lifecycle-admin.mjs",
    "worker:department": "node --env-file=.env scripts/run-department.mjs",
    "worker:organisation": "node --env-file=.env scripts/run-organisation.mjs",
    "verify:knowledge": "npm run build && node scripts/verify-knowledge.mjs",
    "worker:knowledge": "node --env-file=.env scripts/run-knowledge.mjs",
    "worker:development": "node --env-file=.env scripts/run-development.mjs",
    "organisation:prepare": "node scripts/organisation-starter.mjs prepare",
    "organisation:apply": "node --env-file=.env scripts/organisation-starter.mjs apply",
    "test:starter": "node --test scripts/organisation-starter.test.mjs",
    "test:supervisor": "node --test scripts/department-session.test.mjs scripts/department-runtime.test.mjs",
    "verify:organisation": "npm run build && node scripts/verify-organisation.mjs",
    "verify:paired-skills": "npm run build && node scripts/verify-paired-skills.mjs",
    "worker:paired-artifacts": "node --env-file=.env scripts/run-paired-artifacts.mjs",
    "worker:recover-artifacts": "node --env-file=.env scripts/recover-paired-artifacts.mjs",
    "verify:paired-artifacts": "npm run build && node scripts/verify-paired-skills.mjs --artifacts",
    "verify:artifact-sandbox": "node scripts/verify-artifact-sandbox.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/throttler": "6.7.1",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2"
  }
}
