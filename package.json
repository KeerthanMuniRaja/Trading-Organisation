{
  "name": "trading-organisation",
  "version": "0.1.35",
  "private": true,
  "description": "Owner-controlled trading organisation: paper-first backend and research workers",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "review:news": "node --env-file=.env scripts/review-news-queue.mjs",
    "sources:feed": "node --env-file=.env scripts/run-feed-cycle.mjs",
    "model:local": "node --env-file-if-exists=.env scripts/local-model.mjs",
    "model:tune": "node scripts/model-tune.mjs",
    "model:upgrade": "node --env-file-if-exists=.env scripts/model-upgrade.mjs",
    "firm": "node --env-file-if-exists=.env scripts/firm.mjs",
    "handover": "node scripts/handover.mjs",
    "weekly": "node scripts/weekly-review.mjs",    "verify:real-model": "npm run build && node --env-file=.env scripts/verify-real-model.mjs",
    "model:doctor": "node --env-file=.env scripts/run-model-tool.mjs doctor",
    "model:benchmark": "node --env-file=.env scripts/run-model-tool.mjs benchmark",
    "test:feeds": "node --test integrations/publisher-feeds/*.test.mjs scripts/run-feed-cycle.test.mjs",
    "verify:feeds": "npm run build && node scripts/verify-feeds.mjs",
    "sources:collect:vibe": "node scripts/collect-vibe-news.mjs",
