    "learning:workflow": "node --env-file=.env scripts/learning-workflow-admin.mjs",
    "sources:import": "node --env-file=.env scripts/import-observations.mjs",
    "test:sources": "node --test scripts/import-observations.test.mjs",
    "backup": "node --env-file=.env scripts/backup.mjs",
    "test:backup": "npm run build && node --test scripts/backup.test.mjs",
    "alerts:deliver": "node --env-file=.env scripts/deliver-alerts.mjs",
    "test:alerts": "node --test scripts/deliver-alerts.test.mjs",
    "scan:secrets": "node scripts/secret-scan.mjs",
    "cycle": "node --env-file=.env scripts/organisation-cycle.mjs",
    "verify": "node scripts/verify-all.mjs",
    "digest": "node --env-file=.env scripts/daily-digest.mjs",
    "readiness": "node --env-file=.env scripts/readiness.mjs",
    "fitness:live": "node --env-file=.env scripts/live-fitness.mjs",
    "rulebot": "node --env-file=.env scripts/activate-rule-bot.mjs",
    "agenda": "node --env-file=.env scripts/agenda.mjs",
    "bot-credential": "node scripts/bot-credential.mjs",
    "env:prune": "node scripts/prune-env-backups.mjs",
    "autonomy": "node --env-file=.env scripts/autonomy.mjs",
    "protections": "node --env-file=.env scripts/protections.mjs",
    "charter": "node --env-file=.env scripts/charter.mjs",
    "export-data": "node scripts/export-data.mjs",
    "supervisor": "node --env-file-if-exists=.env scripts/supervisor.mjs",
    "members": "node --env-file=.env scripts/member-setup.mjs",
    "status": "node --env-file=.env scripts/status.mjs",
    "world": "node --env-file-if-exists=.env scripts/world-news.mjs",
    "intraday": "node --env-file-if-exists=.env scripts/intraday-monitor.mjs",
    "preflight": "node --env-file-if-exists=.env scripts/preflight.mjs",
    "knowledge": ".local\\replay-venv\\Scripts\\python.exe integrations/trading-desk/knowledge_index.py",
    "pulse": ".local\\replay-venv\\Scripts\\python.exe integrations/trading-desk/market_pulse.py",
    "test:cycle": "node --test scripts/organisation-cycle.test.mjs",
    "test:secrets": "node --test scripts/secret-scan.test.mjs",
    "build": "tsc -p backend/tsconfig.json",
    "test": "npm run build && node --test --test-concurrency=1 backend/dist/test/*.test.js",
    "start": "node --env-file=.env backend/dist/src/main.js",
    "dev:setup": "node scripts/setup-local.mjs",
    "demo": "node --env-file=.env scripts/demo.mjs",
    "worker:research": "node --env-file=.env scripts/run-worker.mjs researcher",
    "worker:evaluation": "node --env-file=.env scripts/run-worker.mjs evaluator",
    "worker:coordination": "node --env-file=.env scripts/run-worker.mjs coordinator",
    "test:ruflo": "node --test integrations/ruflo/coordinator.test.mjs integrations/ruflo/mirror.test.mjs",
    "test:ruflo:live": "npm run build && node integrations/ruflo/live.mjs",
    "ruflo:doctor": "node integrations/ruflo/doctor.mjs",
    "check": "npm run test",
    "academy:run": "node scripts/run-academy.mjs run",
    "academy:test": "node scripts/run-academy.mjs test",
    "worker:portfolio": "node --env-file=.env scripts/run-portfolio.mjs",
    "verify:portfolio": "node scripts/verify-portfolio.mjs",
    "worker:lifecycle": "node --env-file=.env scripts/run-lifecycle.mjs",
    "lifecycle:admin": "node --env-file=.env scripts/lifecycle-admin.mjs",
    "worker:department": "node --env-file=.env scripts/run-department.mjs",
    "worker:organisation": "node --env-file=.env scripts/run-organisation.mjs",
    "verify:knowledge": "npm run build && node scripts/verify-knowledge.mjs",
    "worker:knowledge": "node --env-file=.env scripts/run-knowledge.mjs",
    "worker:development": "node --env-file=.env scripts/run-development.mjs",
    "organisation:prepare": "node scripts/organisation-starter.mjs prepare",
    "organisation:apply": "node --env-file=.env scripts/organisation-starter.mjs apply",
    "test:starter": "node --test scripts/organisation-starter.test.mjs",
    "test:supervisor": "node --test scripts/department-session.test.mjs scripts/department-runtime.test.mjs",
    "verify:organisation": "npm run build && node scripts/verify-organisation.mjs",
    "verify:paired-skills": "npm run build && node scripts/verify-paired-skills.mjs",
    "worker:paired-artifacts": "node --env-file=.env scripts/run-paired-artifacts.mjs",
    "worker:recover-artifacts": "node --env-file=.env scripts/recover-paired-artifacts.mjs",
    "verify:paired-artifacts": "npm run build && node scripts/verify-paired-skills.mjs --artifacts",
    "verify:artifact-sandbox": "node scripts/verify-artifact-sandbox.mjs",
    "test:model-launchers": "node --test scripts/model-launchers.test.mjs",
    "paper:nse": "node --env-file-if-exists=.env.market scripts/nse-paper-trial.mjs",
    "test:nse": "node --test integrations/kite/*.test.mjs",
    "paper:replay": "node scripts/market-replay.mjs",
    "learning:replay": "node --env-file=.env scripts/import-replay-evidence.mjs",
    "test:replay-import": "node --test scripts/import-replay-evidence.test.mjs",
    "model:practice": "node --env-file-if-exists=.env scripts/run-model-tool.mjs practice",
    "knowledge:obsidian": "node scripts/obsidian-sync.mjs",
    "test:obsidian": "node --test scripts/obsidian-sync.test.mjs scripts/obsidian-lessons.test.mjs scripts/obsidian-organisation.test.mjs",
    "knowledge:organisation": "node --env-file=.env scripts/obsidian-organisation.mjs",
    "knowledge:note": "node --env-file-if-exists=.env scripts/obsidian-lessons.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/throttler": "6.7.1",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2"
  }
}
